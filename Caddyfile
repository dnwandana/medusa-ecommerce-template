{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy storefront:3000
}

# Search engines must not index the API or Medusa Admin at /app.
api.{$DOMAIN} {
	header X-Robots-Tag "noindex, nofollow"
	handle /robots.txt {
		respond "User-agent: *
Disallow: /
" 200
	}
	handle {
		reverse_proxy medusa-server:9000
	}
}

# The Garage bucket has the global alias assets.<domain>. Garage finds the bucket by the Host header.
assets.{$DOMAIN} {
	reverse_proxy garage:3902
}
