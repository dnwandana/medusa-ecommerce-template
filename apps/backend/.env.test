DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:9000
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
STOREFRONT_URL=http://localhost:3000
MEDUSA_BACKEND_URL=http://localhost:9000
# The test loader also reads .env. This empty value loads first and keeps the Redis modules off.
REDIS_URL=
# This empty value loads before .env and keeps the S3 provider off. The tests do not need Garage.
S3_BUCKET=
# The integration tests replace fetch for this host. No test calls the real Mayar API.
MAYAR_API_URL=https://mayar.test/hl/v2
MAYAR_API_KEY=test-key
STORE_OWNER_EMAIL=owner@example.com
