DATABASE_URL=postgres://postgres:postgres@localhost:5432/medusa-store
# Set to false only when PostgreSQL has no TLS certificate (the production Compose file).
DATABASE_SSL=
REDIS_URL=redis://localhost:6379
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000,http://localhost:5173
AUTH_CORS=http://localhost:3000,http://localhost:9000,http://localhost:5173
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
STOREFRONT_URL=http://localhost:3000
MEDUSA_BACKEND_URL=http://localhost:9000
MEDUSA_WORKER_MODE=shared
DISABLE_MEDUSA_ADMIN=false

# The shipping price in rupiah for each kilogram.
SHIPPING_RATE_PER_KG=10000

# Leave BREVO_API_KEY empty in development. The backend then writes each email to the log.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=My Store

# Mayar sandbox. Get a key at https://web.mayar.io/api-keys (scope: Read & Write).
# With an empty key the backend starts, but checkout shows an error.
MAYAR_API_URL=https://api.mayar.io/hl/v2
MAYAR_API_KEY=
# The check-paid-carts job sends the paid-cart-alert email to this address.
STORE_OWNER_EMAIL=

# Product images in Garage from docker-compose.local.yml. Do the Garage step in
# docs/development.md first. If S3_BUCKET is empty, Medusa uses local file storage.
# Only the tests use local file storage.
S3_BUCKET=store-assets
S3_FILE_URL=http://assets.localhost:3902
S3_REGION=garage
S3_ENDPOINT=http://localhost:3900
# The values that "garage key create medusa-app-key" prints.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
