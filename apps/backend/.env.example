DATABASE_URL=postgres://postgres:postgres@localhost:5432/medusa-store
# Set to false only when PostgreSQL has no TLS certificate (the production Compose file).
DATABASE_SSL=
REDIS_URL=redis://localhost:6379
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000,http://localhost:5173
AUTH_CORS=http://localhost:3000,http://localhost:9000,http://localhost:5173
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
# Hours of no activity before the session ends. Empty means 168. Admin users share the value.
SESSION_TTL_HOURS=
STOREFRONT_URL=http://localhost:3000
MEDUSA_BACKEND_URL=http://localhost:9000
MEDUSA_WORKER_MODE=shared
DISABLE_MEDUSA_ADMIN=false

# The shipping price in rupiah for each kilogram.
SHIPPING_RATE_PER_KG=10000

# true or false. false hides bank transfer from new customers. Empty means true.
BANK_TRANSFER_ENABLED=
# Hours that a customer has to pay by bank transfer. Empty means 24.
BANK_TRANSFER_DEADLINE_HOURS=

# Email goes to Mailpit from docker-compose.local.yml. Open http://localhost:8025 to read it.
# If SMTP_HOST is empty, the backend writes each email to the log.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@everyday.com
EMAIL_FROM_NAME=Everyday

# The fallback address for the owner emails (receipt-uploaded and paid-cart-alert). The backend
# uses it only when the store contact email (Settings -> Store) is empty.
STORE_OWNER_EMAIL=

# Product images in Garage from docker-compose.local.yml. Do the Garage step in
# docs/development.md first. If S3_BUCKET is empty, Medusa uses local file storage. Use local
# file storage for development only. NODE_ENV=production requires S3_BUCKET.
S3_BUCKET=store-assets
S3_FILE_URL=http://assets.localhost:3902
S3_REGION=garage
S3_ENDPOINT=http://localhost:3900
# true for path-style URLs, false for AWS S3 with virtual-hosted URLs. Empty means true.
S3_FORCE_PATH_STYLE=
# The values that "garage key create medusa-app-key" prints.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Private bucket for the payment receipts. It has no web endpoint.
S3_RECEIPTS_BUCKET=store-receipts
# Receipt directory when S3_BUCKET is empty.
# RECEIPTS_DIR=uploads/receipts
