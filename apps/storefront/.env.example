# The URL that the browser uses to call Medusa.
NUXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
# The URL that the Nuxt server uses to call Medusa. In production, this is the internal address.
NUXT_MEDUSA_BACKEND_URL=http://localhost:9000
# The publishable API key. The seed command prints it. See docs/development.md.
NUXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
