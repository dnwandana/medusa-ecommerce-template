# Production values. Copy this file to .env on the server and replace each example value.
# Do not use the characters $ and ` in a value. See docs/deployment.md for the rules of each key.

# Remove a profile for a managed service or another proxy.
COMPOSE_PROFILES=postgres,redis,caddy

# The storefront host. The default API host is api.<DOMAIN>.
DOMAIN=example.com
# Empty means the default from DOMAIN: https://<DOMAIN> and https://api.<DOMAIN>.
# Each value starts with https:// and has no path and no slash at the end.
# The two hosts must be on the same site, for example www.shop.com and admin.shop.com.
STOREFRONT_URL=
MEDUSA_BACKEND_URL=
# Caddy gives this address to the certificate authority.
ACME_EMAIL=owner@example.com

# openssl rand -hex 32
POSTGRES_PASSWORD=change-me
# openssl rand -hex 32
JWT_SECRET=change-me
# openssl rand -hex 32
COOKIE_SECRET=change-me
# Hours of no activity before the session ends. Empty means 168. Admin users share the value.
SESSION_TTL_HOURS=

# Empty means the postgres service. Set it for a managed PostgreSQL.
DATABASE_URL=
# Empty means false, the value for the postgres service. Other values keep the Medusa TLS default.
DATABASE_SSL=

# The redis service of docker-compose.yml. Change it only for a managed Redis.
REDIS_URL=redis://redis:6379

# The S3 store of your provider. See docs/deployment.md.
# The public bucket for the product images.
S3_BUCKET=store-assets
# A private bucket with no public access.
S3_RECEIPTS_BUCKET=store-receipts
# Empty for AWS S3. The AWS SDK then uses the endpoint of S3_REGION.
S3_ENDPOINT=https://s3.example.com
# true for path-style URLs, false for AWS S3 with virtual-hosted URLs. Empty means true.
S3_FORCE_PATH_STYLE=
S3_REGION=change-me
# The public URL of S3_BUCKET.
S3_FILE_URL=https://assets.example.com
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me

# The PUBLISHABLE_KEY line that the seed script prints. Empty until the first seed.
MEDUSA_PUBLISHABLE_KEY=

SHIPPING_RATE_PER_KG=10000

# true or false. false hides bank transfer from new customers. Empty means true.
BANK_TRANSFER_ENABLED=
# Hours that a customer has to pay by bank transfer. Empty means 24.
BANK_TRANSFER_DEADLINE_HOURS=

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=change-me
SMTP_PASSWORD=change-me
EMAIL_FROM=no-reply@everyday.com
EMAIL_FROM_NAME=Everyday
STORE_OWNER_EMAIL=owner@example.com
