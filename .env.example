# Production values. Copy this file to .env on the server and replace each example value.
# Do not use the characters $ and ` in a value. See docs/deployment.md for the rules of each key.

# The storefront host. The API host is api.<DOMAIN>. The asset host is assets.<DOMAIN>.
DOMAIN=example.com
# Caddy gives this address to the certificate authority.
ACME_EMAIL=owner@example.com

# openssl rand -hex 32
POSTGRES_PASSWORD=change-me
# openssl rand -hex 32
JWT_SECRET=change-me
# openssl rand -hex 32
COOKIE_SECRET=change-me

# openssl rand -hex 32
GARAGE_RPC_SECRET=change-me
# openssl rand -hex 32
GARAGE_ADMIN_TOKEN=change-me
# openssl rand -hex 32
GARAGE_METRICS_TOKEN=change-me
# The values that "garage key create medusa-app-key" prints. See docs/deployment.md.
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me

# The PUBLISHABLE_KEY line that the seed script prints. Empty until the first seed.
MEDUSA_PUBLISHABLE_KEY=

SHIPPING_RATE_PER_KG=10000

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=change-me
SMTP_PASSWORD=change-me
EMAIL_FROM=orders@example.com
EMAIL_FROM_NAME=Everyday
STORE_OWNER_EMAIL=owner@example.com
